#!/usr/bin/env bash
# squintthru: open the SquintThru app window, or control the background service.
#   squintthru            open the app window (starts the service if needed)
#   squintthru start|stop|restart|status
#   squintthru log        follow the service log
#   squintthru autostart on|off|status   start SquintThru by itself, or not
#   squintthru stats [--compare]   measure SquintThru's CPU, wakeups and battery cost
#   squintthru uninstall
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
URL="http://127.0.0.1:8765"
UNIT="squintthru.service"
LOG="$HERE/squint.log"
AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/squintthru.desktop"
# The background service runs under your user's systemd. The desktop session can point
# XDG_RUNTIME_DIR at its own folder, and shells may not set it at all, which makes systemd
# look missing ("Failed to connect to user scope bus"). Only systemctl gets the real one:
# the app window still needs the session's own.
sd() {
  local dir="${XDG_RUNTIME_DIR:-}"
  [[ -S "$dir/systemd/private" ]] || dir="/run/user/$(id -u)"
  XDG_RUNTIME_DIR="$dir" systemctl --user "$@"
}
has_service() { sd cat "$UNIT" >/dev/null 2>&1; }

running() { python3 -c "import urllib.request; urllib.request.urlopen('$URL/state', timeout=1)" 2>/dev/null; }

ensure_running() {
  running && return 0
  if has_service; then
    sd start "$UNIT"
  else
    # Not installed as a service: run it in the background from here.
    nohup python3 -u "$HERE/squint.py" >>"$LOG" 2>&1 &
  fi
  for _ in $(seq 30); do running && return 0; sleep 0.1; done
  echo "SquintThru didn't start. See: squintthru log" >&2
  return 1
}

autostart_on() {
  if has_service; then
    sd enable "$UNIT" >/dev/null 2>&1
    rm -f "$AUTOSTART"
  else
    # No service: start SquintThru when you log in to the desktop instead.
    mkdir -p "$(dirname "$AUTOSTART")"
    cat >"$AUTOSTART" <<EOF
[Desktop Entry]
Type=Application
Name=SquintThru service
Comment=Starts SquintThru in the background
Exec="$HERE/squintthru" start
Icon=$HERE/icon.svg
Terminal=false
NoDisplay=true
X-KDE-autostart-phase=2
EOF
  fi
}

autostart_off() {
  if has_service; then sd disable "$UNIT" >/dev/null 2>&1; fi
  rm -f "$AUTOSTART"
}

autostart_status() {
  if [[ -e "$AUTOSTART" ]] || (has_service && sd is-enabled -q "$UNIT"); then echo on; else echo off; return 1; fi
}

open_window() {
  # A Chromium-based browser in --app mode gives a plain window with no tabs or address bar.
  local profile="${XDG_DATA_HOME:-$HOME/.local/share}/squintthru/window"
  local args=(--app="$URL" --class=SquintThru --window-size=560,940)
  for b in chromium chromium-browser google-chrome google-chrome-stable brave brave-browser microsoft-edge microsoft-edge-stable; do
    if command -v "$b" >/dev/null; then
      mkdir -p "$profile"
      exec "$b" "${args[@]}" --user-data-dir="$profile" --no-first-run >/dev/null 2>&1
    fi
  done
  if command -v flatpak >/dev/null; then
    for id in org.chromium.Chromium com.google.Chrome com.brave.Browser com.microsoft.Edge; do
      if flatpak info "$id" >/dev/null 2>&1; then
        exec flatpak run "$id" "${args[@]}" >/dev/null 2>&1
      fi
    done
  fi
  # No Chromium-family browser: a normal tab still works (and offers "Install app" where supported).
  exec xdg-open "$URL"
}

case "${1:-open}" in
  open)      ensure_running && open_window ;;
  start)     ensure_running && echo "SquintThru is running." ;;
  stop)      if has_service; then sd stop "$UNIT"; fi
             pkill -f "python3 -u $HERE/squint.py" || true ;;
  restart)   if has_service; then sd restart "$UNIT"; else "$0" stop; sleep 0.5; ensure_running; fi ;;
  status)    if running; then echo "running at $URL"; else echo "not running"; exit 1; fi ;;
  log)       if has_service; then journalctl --user -u "$UNIT" -f -n 50; else tail -n 50 -f "$LOG"; fi ;;
  autostart) case "${2:-status}" in
               on)     autostart_on ;;
               off)    autostart_off ;;
               status) autostart_status ;;
               *)      sed -n '2,8p' "$0"; exit 2 ;;
             esac ;;
  stats)     shift; exec python3 "$HERE/stats.py" "$@" ;;
  uninstall) exec "$HERE/install.sh" --uninstall ;;
  *)         sed -n '2,8p' "$0"; exit 2 ;;
esac
